    "/api/audio/level": {
      "get": {
        "description": "Server-sent input levels for the Settings meters.\n\n``me`` is the microphone, ``them`` the system-audio loopback. They are different\nendpoints, so both can be metered at once — which is also the quickest way to see\ncrosstalk: if both bars move when only the far side is talking, the microphone is\npicking up system audio.\n\nWhile a meeting is recording the endpoints are already open, so this reports the\nrecorder's own levels rather than fighting it for them.",
        "operationId": "audio_level_api_audio_level_get",
        "parameters": [
          {
            "in": "query",
            "name": "device",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Device"
            }
          },
          {
            "in": "query",
            "name": "track",
            "required": false,
            "schema": {
              "default": "me",
              "title": "Track",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Audio Level"
      }
    },
