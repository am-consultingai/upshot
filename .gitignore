# run-app.ps1 keeps its runtime outside the source tree by default; these cover the
# case where someone points -WorkDir back into the repo.
.uv-*/

# Real meeting recordings used for manual checks. Never committed: they are
# third-party audio and transcripts, and 13 MB of mp3 has no place in git.
tests/transcripts/
artifacts/
frontend/tsconfig.tsbuildinfo

# Written by packaging/build.ps1 for the freeze: ffmpeg, the version/commit stamp, and
# the public half of the test signing certificate.
vendor/
app/build_info.json
*.cer
build-*.log

# The Google OAuth client ships inside the application but never in git: this repository
# is public, and a client posted here gets picked up by leak scanners and disabled
# (app/gcal/client.py).
app/gcal/google_oauth_client.json
client_secret*.json
google_oauth_client.json

# The developer's own machines and accounts: the two-machine agent loop, the machine B
# scenario runner, Claude Code's project permissions and the ClickUp workspace. They name
# a local network, user names, key files and account ids, and none of the app needs
# them. Kept on the developer's disk only; removed from this public repository's history.
scripts/agent/
scripts/windows/scenarios/
scripts/windows/run-app.local.psd1
# The official build's Sentry DSNs and organization (D87): they identify the Sentry
# account. build.ps1 stamps them into the build; a build from source has none and sends
# nothing. The Sentry auth token is never in the repo at all.
packaging/release.local.json
# Private keys, the update signing keys among them (scripts/release_key.py, D87). They
# live outside the repository; this stops one copied in by mistake from being committed.
*.key
CLAUDE.local.md
# Local scratch tools: they name this machine's browser build and folders.
frontend/.pw-local.config.ts
frontend/.shot.mjs
.claude/settings.json
.claude/clickup.md

# UI/UX makeover research: screenshots of this app and of competitors, plus notes.
# Scratch material for a redesign, not part of the product.
.ui-research/

# Design documents, decisions, plans and product research live in the private
# am-consultingai/upshot-internal repository, cloned here as internal/. .research is a
# symlink into it, kept so older notes and tools that name that path still work.
internal/
.research
.research/
.cache/
