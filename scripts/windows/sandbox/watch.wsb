<Configuration>
  <!-- On the test machine: click through an Upshot install yourself (the wizard waits for you).
       A template: Start-UpshotSandbox.ps1 -Wsb <show|watch> (or Run-Upshot-Sandbox.cmd watch) writes the
       kit\ folder beside it for __KIT__ and opens the copy. kit\ holds sandbox-test.ps1 and an in\ folder
       with Upshot-<ver>-installer.zip, its .sha256 and upshot-test-signing.cer.
       Results land in the kit's out\ folder on the host. -->
  <Networking>Enable</Networking>
  <VGpu>Disable</VGpu>
  <AudioInput>Disable</AudioInput>
  <MemoryInMB>6144</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>__KIT__</HostFolder>
      <SandboxFolder>C:\watch</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -NoExit -ExecutionPolicy Bypass -File C:\watch\sandbox-test.ps1 -Mode watch -In C:\watch\in -Out C:\watch\out</Command>
  </LogonCommand>
</Configuration>
