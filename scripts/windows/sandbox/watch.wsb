<Configuration>
  <!-- Double-click on the test machine to click through an Upshot install yourself (the wizard waits for you).
       <kit folder> must hold: this file, sandbox-test.ps1, and an in\ folder
       with Upshot-<ver>-installer.zip, its .sha256 and upshot-test-signing.cer.
       Results land in <kit folder>\out on the host. -->
  <Networking>Enable</Networking>
  <VGpu>Disable</VGpu>
  <AudioInput>Disable</AudioInput>
  <MemoryInMB>6144</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder><kit folder></HostFolder>
      <SandboxFolder>C:\watch</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -NoExit -ExecutionPolicy Bypass -File C:\watch\sandbox-test.ps1 -Mode watch -In C:\watch\in -Out C:\watch\out</Command>
  </LogonCommand>
</Configuration>
