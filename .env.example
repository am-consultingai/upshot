# This machine's own values for the developer scripts. Copy to .env (gitignored, never
# committed) and fill in what this machine needs; a script that needs a key that is not set
# stops and names it. KEY=value, one per line, no spaces around = and no comment after a
# value; a value may start with ~
# (not in the sandbox kit's .env); a relative path is from the repository root.

# Releases (scripts/publish_release.py, scripts/release_key.py, packaging/build.ps1)
# The folder that holds the update signing keys (<name>.key, owner-only).
UPSHOT_RELEASE_KEY_DIR=
# The release settings file (Sentry DSNs, signer thumbprint, secret_files); when unset,
# packaging/release.local.json in this checkout.
UPSHOT_RELEASE_SETTINGS=
# The file holding the Sentry auth token; when unset, the settings' sentry_token_file.
UPSHOT_SENTRY_TOKEN_FILE=

# The test machine's sandbox kit (scripts/windows/sandbox): a .env beside
# Run-Upshot-Sandbox.cmd, in that folder of its own (not in its kit\ subfolder), with these two.
# The Drive folder the kit and the installer zip are fetched from.
UPSHOT_SANDBOX_DRIVE_FOLDER=
# The absolute folder in that machine's WSL holding drive.py and the runner's STOP file.
UPSHOT_AGENT_DIR=
