# The Terms (D83): the published copy's SHA-256 is taken over LF text, and the installer's
# licence page is CRLF on purpose. Neither may be converted by a checkout.
app/legal/terms.md text eol=lf
site/legal/terms.md text eol=lf
site/legal/terms.json text eol=lf
packaging/terms.txt -text
# Batch files run under cmd.exe, which misreads labels and blocks in LF-only files: they
# are kept with CRLF exactly as committed, never converted.
*.cmd -text
*.bat -text
# NVIDIA's licence, byte for byte as in the pinned cuBLAS wheel (its RECORD hash).
app/asr/licenses/*.txt -text
